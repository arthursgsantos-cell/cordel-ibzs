SUPABASE_URL=https://seu-projeto.supabase.co

# Chave PÚBLICA (anon). Fallback apenas — com o RLS ligado ela fica sem acesso.
SUPABASE_ANON_KEY=sua-chave-anon

# Chave SECRETA (service_role) — o servidor usa esta. NUNCA exponha no front.
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Segredo para assinar os tokens de sessão. OBRIGATÓRIO em produção.
# Gere um aleatório, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

PORT=3000
PIX_CHAVE=seu@email.com
PIX_NOME=Sua Empresa

# (Opcional) Domínio externo autorizado a chamar a API por CORS. Em branco =
# só mesma origem (mais seguro). Ex.: https://meuapp.com
APP_ORIGIN=

# Cloudflare Turnstile (anti-robô no autocadastro). Sem essas chaves o app
# funciona normal, só sem a verificação "não sou um robô".
TURNSTILE_SITE_KEY=0x000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000
